{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.list",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "LookupCDC",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"dataset": {
									"referenceName": "brz_cdc_src_ds",
									"type": "DatasetReference",
									"parameters": {
										"folder_name": {
											"value": "@item().table_name",
											"type": "Expression"
										}
									}
								}
							}
						},
						{
							"name": "CopyToADLS",
							"type": "Copy",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "LookupCDC",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select * from @{item().schema_name}.@{item().table_name} where @{item().updated} > '@{activity('LookupCDC').output.firstRow.lastload}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "brz_sql_src_ds",
									"type": "DatasetReference",
									"parameters": {
										"schema_name": {
											"value": "@item().schema_name",
											"type": "Expression"
										},
										"table_name": {
											"value": "@item().table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "brz_parquet_dest_ds",
									"type": "DatasetReference",
									"parameters": {
										"folder_name": {
											"value": "@{item().table_name}",
											"type": "Expression"
										},
										"file_name": {
											"value": "@{item().table_name}_bronze",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Script_max_cdc",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "CopyToADLS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_azure_sql",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "select max(@{item().updated}) as max_cdc from @{item().schema_name}.@{item().table_name} where @{item().updated} > '@{activity('LookupCDC').output.firstRow.lastload}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "copy_cdc_watermark",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Script_max_cdc",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"additionalColumns": [
										{
											"name": "lastload",
											"value": {
												"value": "@activity('Script_max_cdc').output.resultSets[0].rows[0].max_cdc",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "brz_empty_json_ds",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "brz_cdc_dest_ds",
									"type": "DatasetReference",
									"parameters": {
										"folder_name": {
											"value": "@item().table_name",
											"type": "Expression"
										},
										"file_name": "cdc.json"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"list": {
				"type": "array",
				"defaultValue": [
					{
						"schema_name": "returnsDB",
						"table_name": "dim_customer",
						"updated": "updated_at",
						"backdate": ""
					},
					{
						"schema_name": "returnsDB",
						"table_name": "dim_product",
						"updated": "updated_at",
						"backdate": ""
					},
					{
						"schema_name": "returnsDB",
						"table_name": "dim_order",
						"updated": "updated_at",
						"backdate": ""
					},
					{
						"schema_name": "returnsDB",
						"table_name": "dim_return_reason",
						"updated": "updated_at",
						"backdate": ""
					},
					{
						"schema_name": "returnsDB",
						"table_name": "dim_date",
						"updated": "updated_at",
						"backdate": ""
					},
					{
						"schema_name": "returnsDB",
						"table_name": "fact_returns",
						"updated": "updated_at",
						"backdate": ""
					}
				]
			}
		},
		"annotations": []
	}
}